{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://googgier.github.io/roseto-eventi/data/events.schema.json",
  "title": "Eventi Roseto",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "startDate",
      "endDate",
      "displayDate",
      "time",
      "title",
      "venue",
      "city",
      "description",
      "tags",
      "sourceUrl",
      "price",
      "image",
      "updatedAt"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "startDate": {
        "type": "string",
        "format": "date"
      },
      "endDate": {
        "type": "string",
        "format": "date"
      },
      "displayDate": {
        "type": "string",
        "minLength": 1
      },
      "time": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "venue": {
        "type": "string",
        "minLength": 1
      },
      "city": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri"
      },
      "price": {
        "type": "string",
        "enum": [
          "gratis",
          "a pagamento",
          "misto"
        ]
      },
      "image": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
