{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://googgier.github.io/roseto-eventi/data/sagre.schema.json",
  "title": "Sagre in Abruzzo",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "startDate", "endDate", "displayDate", "title", "venue", "province", "sourceLabel", "updatedAt"],
    "properties": {
      "id": {"type": "string", "pattern": "^sagra-2026-[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "startDate": {"type": "string", "format": "date", "pattern": "^2026-08-[0-9]{2}$"},
      "endDate": {"type": "string", "format": "date", "pattern": "^2026-08-[0-9]{2}$"},
      "displayDate": {"type": "string", "minLength": 1},
      "title": {"type": "string", "minLength": 1},
      "venue": {"type": "string", "minLength": 1},
      "province": {"type": "string", "enum": ["AQ", "CH", "PE", "TE"]},
      "sourceLabel": {"type": "string", "const": "Sagre in Abruzzo — Agosto 2026"},
      "updatedAt": {"type": "string", "format": "date"}
    }
  }
}
